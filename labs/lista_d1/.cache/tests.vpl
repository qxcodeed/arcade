$end
"


case=push_back <value ...>
input=push_back 1 2 3 4
show
push_back 1 2 3 4
show
push_front 0 3
show
end
output="$push_back 1 2 3 4
$show
[1, 2, 3, 4]
$push_back 1 2 3 4
$show
[1, 2, 3, 4, 1, 2, 3, 4]
$push_front 0 3
$show
[3, 0, 1, 2, 3, 4, 1, 2, 3, 4]
$end
"


