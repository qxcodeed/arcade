case=init e empty show
input=show
end
output="$show
[]
$end
"


case=push_front <value ...>
input=push_front 1 2 3 4
show
push_front 9 6
show
end
output="$push_front 1 2 3 4
$show
[4, 3, 2, 1]
$push_front 9 6
$show
[6, 9, 4, 3, 2, 1]
$end
"


case=size
input=size
push_front 4
show
size
push_front 3 2 1
show
size
end
output="$size
0
$push_front 4
$show
[4]
$size
1
$push_front 3 2 1
$show
[1, 2, 3, 4]
$size
4
$end
"


